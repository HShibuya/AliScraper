{
    "manifest_version": 3,
    "name": "Aliexpress scraper",
    "version": "1.0",
    "description": "A simple Aliexpress scraper Chrome extension.",
    "permissions": ["storage", "declarativeContent", "activeTab", "scripting"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
      }
    },
    "icons": {
      "16": "favicon-16x16.png",
      "32": "favicon-32x32.png",
      "48": "favicon.ico",
      "128": "apple-touch-icon.png"
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
        {           
            "js": ["content.js"],
            "matches": ["<all_urls>"]
        }
      ]
  }